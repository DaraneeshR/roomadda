# Backend service env. Copy to `backend/.env` for local dev.
# Only this *.example file is committed — never a real .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# ---- Data stores -----------------------------------------------------------
# Postgres (PostGIS) — see docker-compose service "db".
DATABASE_URL=postgresql://roomadda:change_me_in_local_env@localhost:5432/roomadda?schema=public
# Redis — see docker-compose service "redis".
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT) ------------------------------------------------------------
# Generate strong, unique 32+ char secrets per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_32_plus_character_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_plus_char_secret

# ---- Razorpay (payments + webhook verification) ----------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# ---- MSG91 (OTP + SOS + rent reminders) ------------------------------------
MSG91_AUTH_KEY=replace_me
# Required by the live sender (prod); unused by the dev SMS stub.
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
# Transactional template for the SOS safety SMS to a trusted contact (live only).
MSG91_SOS_TEMPLATE_ID=
# Rent reminders. Prefer WhatsApp via the MSG91 BSP: set the integrated number +
# approved template and prod sends the WhatsApp template, else it falls back to
# the SMS flow template below. All blank = dev no-op.
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_RENT_TEMPLATE=
MSG91_RENT_REMINDER_TEMPLATE_ID=
# Walk-in app-invite SMS template (a host records a walk-in tenant; the tenant is
# SMSed a single-use pre-registration token to claim their account). Live sender
# only; blank = dev no-op.
MSG91_WALKIN_INVITE_TEMPLATE_ID=

# ---- SOS ops alerting (SAFETY-CRITICAL) ------------------------------------
# Where an SOS reaches the ops/on-call team. In PRODUCTION the server REFUSES to
# boot unless at least one of these is set. Dev/test leave them blank (logged
# no-op). [MANUAL] — fill with the real on-call destinations per environment.
# Comma-separated E.164 numbers for the on-call SMS distribution list.
SOS_OPS_SMS_NUMBERS=
# Ops incoming webhook (Slack/Teams/PagerDuty). May embed a secret — never logged.
SOS_OPS_WEBHOOK_URL=
# Dedicated MSG91 template for the ops SOS SMS (needed when SOS_OPS_SMS_NUMBERS is set).
MSG91_SOS_OPS_TEMPLATE_ID=

# ---- OTP policy (defaults shown) -------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# ---- CORS allowlist (comma-separated browser origins) ----------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Rate limiting (default 100 requests / 60000 ms / IP) ------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ---- Object storage (S3) ---------------------------------------------------
# Two buckets. PRIVATE (KYC / service-request / chat / inspection docs) is
# encrypted at rest and only ever exposes object keys + presigned GETs. PUBLIC
# (listing photos) is public-read and serves stable URLs. Both are required by
# the live S3 storage in PRODUCTION; dev/test leave them blank and use the stub.
# AWS credentials come from the standard AWS provider chain (env / IAM role).
AWS_REGION=
KYC_S3_BUCKET=
LISTING_PHOTOS_S3_BUCKET=
# Optional CDN / custom-domain base for served listing-photo URLs (e.g.
# https://cdn.roomadda.com). Blank = use the S3 virtual-hosted URL.
LISTING_PHOTOS_PUBLIC_BASE_URL=
# TTL (seconds, max 3600) for every presigned upload URL handed to a client.
KYC_UPLOAD_URL_TTL_SECONDS=300

# ---- Admin dashboard metrics -----------------------------------------------
# Rolling window (hours) for the "settled today" payment totals on GET /v1/metrics.
METRICS_PAYMENTS_WINDOW_HOURS=24

# ---- Agent surface ---------------------------------------------------------
# Commission per CONFIRMED agent-attributed booking, in basis points of the
# booking's monthly rent (same rate for assisted + walk-in). 1000 bps = 10%.
# Read-only in MVP (manual payout).
AGENT_COMMISSION_BPS=1000
# Public base URL the assisted-booking pay link points at (the USER pays from
# their own device). Optional locally; the dev stub uses a local fallback.
PUBLIC_PAY_BASE_URL=

# ---- Roomie assistant (public, LLM-backed) ---------------------------------
# The ONLY secret for this feature. Leave blank to disable Roomie (the endpoint
# then returns 503). Never commit a real key.
ANTHROPIC_API_KEY=
# Model id. Default is the most capable model; set claude-haiku-4-5 for a
# cheaper/faster public assistant (env-only swap, no code change).
ROOMIE_MODEL=claude-opus-4-8
ROOMIE_MAX_OUTPUT_TOKENS=512
# Rate limits (Redis-backed): per-IP/minute AND a global hourly cost ceiling.
ROOMIE_RATE_PER_IP_PER_MINUTE=20
ROOMIE_RATE_GLOBAL_PER_HOUR=2000
# Ephemeral session-context TTL (seconds). No message content is stored elsewhere.
ROOMIE_SESSION_TTL_SECONDS=1800
# Masked listings retrieved as discovery context per turn.
ROOMIE_RETRIEVAL_LIMIT=8
