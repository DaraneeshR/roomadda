# RoomAdda mobile env. Two ways to configure (no secrets here — the API base URL
# is not a secret):
#
#   1) --dart-define (recommended, works with flavors):
#        flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3001 --dart-define=APP_ENV=dev
#
#   2) flutter_dotenv: copy this file to `.env`, then add it as an asset in
#      pubspec.yaml:
#        flutter:
#          assets:
#            - .env
#
# Dev note: 10.0.2.2 is the Android emulator's alias for the host machine's
# localhost (where the backend runs on :3001). For iOS simulator use
# http://localhost:3001; for a physical device use your machine's LAN IP.

API_BASE_URL=http://10.0.2.2:3001
APP_ENV=dev
